  "arms": {
    "continue": {
      "short": "C0",
      "definition": "existing Continue; queue and history untouched; context only"
    },
    "r_keep": {
      "short": "R_KEEP",
      "definition": "existing R5 through Runtime.force(2); the policy resumes on the real last two observations [o_(tau-1), o_tau]"
    },
    "r_pad_once": {
      "short": "R_PAD_ONCE",
      "definition": "the same R5; immediately before the first inference and only once, policy.history becomes [copy(o_tau), o_tau]; afterwards the ordinary observe() FIFO continues"
    },
    "padding_rules": [
      "the whole converted observation entry the policy receives is copied (RGB of both cameras and qpos/qvel/tcp_pose); no partial ablation",
      "the latest entry is left untouched; the earlier entry is an independent copy (no shared memory)",
      "no simulator, controller, raw-observation or object state is written",
      "qvel is not set to zero; a duplicated observation is not a physical stop",
      "no env.step, no waiting, no hold steps are added",
      "queue (already empty after R5), last action, time, intervention record, inference count and RNG are identical in the two R5 arms",
      "policy.reset() is not used; only policy.history is assigned",
      "if the episode ends during R5 nothing is padded and the policy is not called",
      "if the two last observations are identical the padding is a no-op; such blocks are kept"
    ],
    "primary_comparison": "R_PAD_ONCE vs R_KEEP",
    "context_comparisons": [
      "R_KEEP vs C0",
      "R_PAD_ONCE vs C0"
    ]
  },
  "noise": {
    "seed_rule": "seed_for(scene, physical_step_of_the_call, block_repeat_id, 'dp') for every arm (unchanged code path in policies.DiffusionPolicy.generate)",
