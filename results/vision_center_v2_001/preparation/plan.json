  "semantics": {
    "inputs": "base_camera and hand_camera RGB (128 x 128), extra/tcp_pose and agent/qpos of the policy observation, the executed gripper commands, the step counter; fixed camera constants. No cube pose, grasp flag, task flag, outcome or future information. No added camera, no viewpoint motion, no trained model",
    "trigger": {
      "rule": "the oracle pilot trigger, unchanged (hci.recovery_v1_oracle.trigger_rule)",
      "open_cmd_above": 0.0,
      "close_run_min": 3,
      "width_min_m": 0.02,
      "width_max_m": 0.06
    },
    "VISION_CENTER_V1": "hci.vision_center.vision_center, unchanged: the single-frame baseline (hand camera at the trigger only)",
    "VISION_CENTER_V2": {
      "memory": {
        "target": "at every step before the trigger: the hand-camera fit of v1 when accepted, otherwise the base-camera estimate (largest connected lit-green region, area of an unoccluded 4 cm face). Consistent observations confirm one track; an inconsistent observation restarts it; the track is usable after confirm_min observations",
        "invalidation": "a restart on any conflicting observation; steps without an observation while the gripper is near the remembered target (contact_radius_m, contact_tcp_z_m) add u_push_m to the bound; at the trigger the remembered position is checked against the current hand image (lit-green pixels far outside it, or visible table inside it, refuse it)",
        "hold": "the last accepted held-cube fit of v1 (run every hold_every-th step while the gripper is closed on something); dropped when the finger opening changes by more than finger_tol_m or an open command was executed",
        "never": "a remembered position is never used without confirmation, never after a conflict, never against the current image",
        "confirm_min": 3,
        "contact_radius_m": 0.1,
        "contact_tcp_z_m": 0.09,
        "finger_tol_m": 0.001,
        "hold_every": 4,
        "hold_width_max_m": 0.075,
        "u_hand_m": 0.002,
        "u_base_m": 0.005,
        "u_hold_m": 0.002,
        "u_push_m": 0.005,
        "base_view": {
          "ratio_min": 0.9,
          "ratio_max": 1.25,
          "pixels_min": 9
        }
      },
      "estimate": "current frame where v1 accepts it; memory otherwise; no estimate -> abstain. Bound u = target bound + hold bound",
      "abstain": {
        "meaning": "nothing is touched: the episode is the uninterrupted one (checked against the trunk in every scene)",
        "reasons": [
          "NO_HOLD_ESTIMATE",
          "NO_TARGET_ESTIMATE",
          "MEMORY_CONTRADICTED",
          "LOW_CARRY",
          "SIDE_CONTACT_RISK",
          "TOO_FEW_STEPS",
          "ALIGNED",
          "ALIGNED_WITHIN_UNCERTAINTY"
        ],
        "order": "as in hci.vision_center_v2.decide; the first that applies"
      },
      "safety": {
        "LOW_CARRY": "estimated held-cube centre below 0.058 m (v1 rule); with a remembered target also when its bottom is below the target top face",
        "SIDE_CONTACT_RISK": "estimated offset (plus u when the target is remembered) >= 0.04 m (the held cube is beside the target) and its bottom less than 0.003 m above the target top face: scene 50892",
        "during_control": "stop when a new accepted target estimate is more than 0.003 m (plus the bound of a remembered target) from the one in use, when the held-cube fit moves more than 0.003 m in the gripper, when the estimate is lost, when the held cube is estimated too low"
      },
      "acts_when": "estimated offset >= 0.015 m and estimated offset - u >= 0.01 m and no abstain reason",
      "command": "as CENTER_ORACLE and v1: horizontal only, at most 0.005 m per step, commanded target within 0.030 m of the TCP at the trigger, at most 12 steps, vertical command 0, held gripper command",
      "stops_when": "estimated offset <= 0.01 m on a target seen in the current frame, <= 0.005 m on a remembered target; or 12 steps; or the target cap; or the episode ends; or a safety stop",
      "after": "queue cleared, the unchanged policy re-infers",
      "decision": {
        "act_min_m": 0.015,
        "residual_tol_m": 0.01,
        "memory_stop_tol_m": 0.005,
        "carry_z_min_m": 0.058,
        "steps_left_min": 20,
        "side_offset_m": 0.04,
        "side_gap_min_m": 0.003,
        "memory_gap_min_m": 0.0,
        "target_jump_max_m": 0.003,
        "hold_shift_max_m": 0.003,
        "check": {
          "outside_pixels_max": 8,
          "inside_pixels_min": 30,
          "inside_green_min": 0.7,
          "slack_m": 0.004
        }
      }
    },
    "CENTER_ORACLE": "hci.recovery_v1_oracle.center_oracle, unchanged (reads simulator cube positions; diagnostic reference, not deployable)",
    "C0": "the pending action and the rest of the queue are executed; must equal the uninterrupted run, otherwise the run stops",
    "noise": "repeat 0 only; every inference is keyed by seed_for(scene, physical step, 0, 'dp')",
    "restore": "reset(seed) + prefix action replay; the restored runtime is compared with the snapshot before every branch",
    "chosen_on": "every v2 constant was chosen on used data: the 300 used scenes 50600-50899 (traces, trigger frames), the 21 failed diagnostic episodes with video, and the 500 training demonstrations. The four scenes 50813, 50872, 50817, 50846 are part of that development data and are not evidence for v2"
