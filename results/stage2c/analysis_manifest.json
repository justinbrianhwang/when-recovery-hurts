  "rules": {
    "join_key": "(scene, checkpoint, block_repeat_id); duplicates, gaps, conflicts and a block tied to another snapshot are errors",
    "outcomes": "strictly 0 or 1; booleans strictly True or False",
    "pairs": [
      "F vs C0",
      "R vs C0",
      "C1 vs C0",
      "F vs C1",
      "R vs C1",
      "R vs F"
