          "R"
        ],
        "G_CFR": [
          "C0",
          "F",
          "R"
        ]
      },
      "choice": "largest number of successes over the three other repeats",
      "ties": "C0 first, then F, then R",
      "held_out": "every repeat 0..3 of every snapshot; the held-out outcome is never used for the choice",
      "C1": "reported on the same held-out repeat as an additional reference only",
      "meaning": "consistency of the arm ranking across noise repeats of the SAME state. Uses past branch outcomes, so it cannot be deployed. Not generalisation to new scenes, not an observation-based selector, not a policy evaluation, not a causal test."
    },
    "events": {
      "time_axis": "trunk row i = state after step i+1; branch row i = state after step checkpoint+i+1; checkpoint state = trunk row checkpoint-1",
      "retreat_end": "retreat.steps_used of the block, cross-checked with the first inference step of the R arm; never a fixed number",
      "thresholds": {
