  "semantics": {
    "inputs": "hand_camera RGB (128 x 128) and extra/tcp_pose of the policy observation; fixed camera constants; for the trigger: pending and executed actions, agent/qpos. No cube pose, grasp flag, task flag, outcome or future information",
    "trigger": {
      "rule": "the oracle pilot trigger, unchanged (hci.recovery_v1_oracle.trigger_rule)",
      "open_cmd_above": 0.0,
      "close_run_min": 3,
      "width_min_m": 0.02,
      "width_max_m": 0.06
    },
    "perception": {
      "target": "lit green pixels of the hand image are explained by a 4 cm square on the plane z = 0.04 m (the top face of the target cube); red and grey pixels are occluders and are not scored; accepted when the score is at least score_min and the best placement at least far_m away scores lower by margin_min",
      "target_constants": {
        "pixels_min": 40,
        "score_min": 0.9,
        "margin_min": 0.1,
        "far_m": 0.004,
        "stages": [
          [
            0.036,
            0.004,
            6
          ],
          [
            0.004,
            0.001,
            5
          ],
          [
            0.001,
            0.0005,
            3
          ]
        ]
      },
      "held_cube": "lit red pixels are explained by a 4 cm square at the depth of the held cube face (hold offset x, y, z and yaw in the gripper frame); the three best depths are re-scored with the outline of the whole cube against all red pixels; accepted when both scores and the lead over a different solution pass",
      "held_cube_constants": {
        "pixels_min": 200,
        "iou_min": 0.9,
        "outline_min": 0.85,
        "margin_min": 0.02,
        "far_m": 0.004,
        "far_z_m": 0.006,
        "z_span_m": 0.024,
        "z_step_m": [
          0.004,
          0.001
        ],
        "stages": [
          [
            0.02,
            0.004,
            5
          ],
          [
            0.004,
            0.001,
            5
          ],
          [
            0.001,
            0.0005,
            3
          ]
        ]
      },
      "offset": "(TCP position + rotated hold offset) minus target, horizontal part",
      "memory": "none: only the current image is used at the trigger; during control the target estimate of the trigger is kept while the target is hidden",
      "base_camera": "not used for control (about 1 cm per pixel at the cubes; errors of several centimetres pass every single-image check)"
    },
    "abstain": {
      "meaning": "nothing is touched: the pending queue, the history and the counters stay as they are, so the episode is the uninterrupted one (checked against the trunk in every scene)",
      "reasons": {
        "NO_HOLD_ESTIMATE": "held-cube fit missing or not accepted",
        "NO_TARGET_ESTIMATE": "target not accepted in the current image (usually hidden by the held cube)",
        "LOW_CARRY": "estimated height of the held cube centre below 0.058 m: the cube is beside the target, a horizontal move would push it",
        "TOO_FEW_STEPS": "fewer than 20 steps left",
        "ALIGNED": "estimated offset below 0.015 m"
      },
      "order": "as listed; the first that applies"
    },
    "VISION_CENTER": {
      "acts_when": "estimated offset >= 0.015 m and no abstain reason",
      "command": "as CENTER_ORACLE: horizontal only, at most 0.005 m per step, commanded target within 0.030 m of the TCP at the trigger, at most 12 steps, vertical command 0, held gripper command",
      "stops_when": "estimated offset <= 0.01 m, or 12 steps, or the target cap, or the episode ends, or the held-cube fit is lost, or a new accepted target estimate is more than 0.005 m from the one at the trigger, or the held cube is estimated too low",
      "after": "queue cleared, the unchanged policy re-infers",
      "act_min_m": 0.015,
      "residual_tol_m": 0.01,
      "carry_z_min_m": 0.058,
      "steps_left_min": 20,
      "target_jump_max_m": 0.005
    },
    "CENTER_ORACLE": "hci.recovery_v1_oracle.center_oracle, unchanged (reads simulator cube positions; diagnostic reference, not deployable; allowed by the user for this arm only)",
    "C0": "the pending action and the rest of the queue are executed; must equal the uninterrupted run, otherwise the run stops",
    "noise": "repeat 0 only; every inference is keyed by seed_for(scene, physical step, 0, 'dp')",
    "restore": "reset(seed) + prefix action replay; the restored runtime is compared with the snapshot before every branch",
    "chosen_on": "ACT threshold, carry limit, step limit and all perception constants were chosen on used data: the 200 used scenes (traces), the 21 failed diagnostic episodes with frames, and the training demonstrations"
  },
